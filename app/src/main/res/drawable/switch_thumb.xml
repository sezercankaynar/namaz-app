<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="@dimen/switch_track_h" android:height="@dimen/switch_track_h" />
            <solid android:color="@color/transparent" />
        </shape>
    </item>
    <item android:left="@dimen/switch_thumb_inset" android:top="@dimen/switch_thumb_inset"
        android:right="@dimen/switch_thumb_inset" android:bottom="@dimen/switch_thumb_inset">
        <shape android:shape="oval">
            <size android:width="@dimen/switch_thumb" android:height="@dimen/switch_thumb" />
            <solid android:color="@color/switch_thumb" />
        </shape>
    </item>
</layer-list>
